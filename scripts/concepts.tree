# OntoMem concept hierarchy (source for src/ontomem/data/ontology/concepts.ttl)
#
# Format:  LocalName: preferred label | alt label, alt label, ...
# Indentation (2 spaces) = skos:narrower.  A concept may appear under a second
# parent with the line  "  ^LocalName"  (polyhierarchy, e.g. Sushi is Japanese AND Seafood).
# Lines starting with "@related A B" add skos:related links (used for query expansion).
# Labels are matched case-insensitively after plural normalisation, so list singular forms.

Food: food | cuisine, cooking, eating, meal, dish
  SpicyFood: spicy food | spicy dish, spicy, spicy cuisine, hot food, fiery food, chilli, chili, chilli food, hot and spicy food, anything spicy
  SweetFood: sweet food | sweets, sweet stuff, sugary food, sweet thing
    Dessert: dessert | pudding, after-dinner sweet
      IceCream: ice cream | gelato
      Chocolate: chocolate | dark chocolate, milk chocolate
      Cake: cake | cheesecake, pastry, pastries
      IndianSweets: indian sweets | mithai, gulab jamun, rasgulla, jalebi
  Seafood: seafood | sea food, fruits de mer
    Fish: fish | fish dish
      Salmon: salmon | smoked salmon
      Tuna: tuna | tuna steak
      Sardine: sardines | sardine
    Shellfish: shellfish | shell fish
      Shrimp: shrimp | prawn, prawns, prawn curry, shrimp curry, shrimps
      Crab: crab | crab meat
      Lobster: lobster | lobster tail
      Oyster: oysters | oyster
      Mussel: mussels | mussel, clam, clams
    Sushi: sushi | sashimi, nigiri, maki, sushi roll
  Meat: meat | meat dish
    RedMeat: red meat | beef, steak, lamb, mutton, pork
    Poultry: poultry | chicken, turkey, duck
      ChickenWings: chicken wings | wings, buffalo wings
  VegetarianFood: vegetarian food | vegetarian dish, veggie food, veg food, vegetarian
    VeganFood: vegan food | plant-based food, vegan dish, plant based food, vegan
    Paneer: paneer | cottage cheese, paneer tikka
    Tofu: tofu | bean curd
  Dairy: dairy | dairy product, milk products
    Cheese: cheese | cheddar, mozzarella, parmesan, blue cheese
    Milk: milk | cow milk
    ^IceCream
  Vegetables: vegetables | veggies, greens, vegetable
    Mushroom: mushrooms | mushroom, button mushroom, shiitake
    Broccoli: broccoli | broccolini
    Eggplant: eggplant | brinjal, aubergine
    Okra: okra | bhindi, lady finger
  Fruit: fruit | fruits
    Mango: mango | mangoes, alphonso
    Durian: durian | durian fruit
  Grains: grains | carbs, carbohydrate
    Rice: rice | biryani, fried rice, rice dish
    Bread: bread | sourdough, naan, roti, chapati
    Pasta: pasta | spaghetti, penne, noodles, lasagna
  Nuts: nuts | nut, peanut, peanuts, almonds, cashews, tree nuts
  Gluten: gluten | wheat, gluten food
  FastFood: fast food | junk food, takeaway, takeout
    Pizza: pizza | pizzas, margherita
    Burger: burgers | burger, cheeseburger, hamburger
    FrenchFries: fries | french fries, chips
  FriedFood: fried food | deep fried food, deep-fried food, greasy food, oily food
